# ============================================================
# 爆款视频复刻 · 提示词 Agent —— 环境配置模板
#
# 用法：把本文件复制成 .env，再填入自己的 Key。
#   Windows :  copy .env.example .env
#   Linux   :  cp .env.example .env
#
# .env 已在 .gitignore 里，**永远不会被提交到 GitHub**。
#
# ⚠️ 写值的时候不要在行尾加注释！
#     本项目的 .env 解析器不剥行尾注释，
#     `MODEL_TEXT=abc  # 说明` 会把整串当成模型名。
#     注释请单独占一行。
# ============================================================

# ---- 必填：模型接口 ----
# 申请地址：https://platform.xiaomimimo.com/#/console/api-keys
MIMO_API_KEY=sk-your-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ---- 分层模型分工（PRD §6.1.3）----
# L1 视觉理解
MODEL_VISION=mimo-v2.6-flash
# L2 语义归纳 + L3 结构化输出
MODEL_TEXT=mimo-v2.6-flash
# L0 语音识别
MODEL_ASR=mimo-v2.5-asr

# ---- 媒体工具 ----
# Linux / Docker 下保持裸命令即可（ffmpeg 由系统或镜像提供）。
# 仅当 ffmpeg 不在 PATH 里时才需要写绝对路径。
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ---- 工作区 ----
# 上传的视频、抽帧、IR 快照、YOLO 权重都落在这个目录下。
# 相对路径按项目根目录解析。
# Docker 部署时 docker-compose.yml 会覆盖成 /data/workspace（挂卷持久化）。
WORKSPACE_DIR=workspace

# ---- 抽帧与镜头切分 ----
FRAMES_PER_SHOT=3
# 切点阈值：帧间色差（BT.601 加权归一化）。
# 实测硬切 0.40~0.50、同场景明显色变约 0.15。
# 调低更敏感（快速摇镜可能被误判成切镜），调高会漏切。
SCENE_THRESHOLD=0.10

# ---- 网络 ----
REQUEST_TIMEOUT_SEC=180
MAX_RETRIES=2

# ---- 按用户意见改写提示词（PRD F8.4）----
# 留空 = 跟 MiMo 用同一个端点与 Key。
# 想换成别的供应商（例如 DeepSeek 官方）只需填这两行，不用改代码：
# REVISE_BASE_URL=https://api.deepseek.com/v1
# REVISE_API_KEY=sk-your-other-key
# MODEL_REVISE=deepseek-chat
#
# 改写后是否再跑一遍 14 项交付闸门。默认 0（不跑，改完直接填回文本框）。
# REVISE_CHECK_GATES=0

# ---- 自检-重写回路（交付前让模型回头看一遍）----
# 0 = 关闭，退回单向管线（少几次模型调用，快几分钟）
# REVIEW_ENABLED=1
# 自检专用模型：实测换成它以后自检从 563 秒降到 52 秒。留空 = 跟 MODEL_TEXT
# MODEL_REVIEW=mimo-v2.6-pro-ultraspeed
# 自检总时间预算（秒）
# REVIEW_BUDGET_SEC=480

# ---- 并发与排队（多人同时使用时才需要调）----
# 一次反推要调十几次模型，不封顶会撞模型接口限流。
# 服务器 CPU / 内存越小，越应该调低 MAX_CONCURRENT_INFER。
# MAX_CONCURRENT_INFER=2
# MAX_QUEUED_INFER=20

# ============================================================
# 其余全部可调项（取证预算、感知补看次数、台词归属预算、
# 证据体积上限、改写历史上限……）见 engine/app/config.py 的
# Settings 类：键名 = 字段名大写。
# ============================================================
