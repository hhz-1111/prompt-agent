# 复制为 .env 并填入自己的 Key。.env 不会被提交。
MIMO_API_KEY=sk-your-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 分层模型分工（PRD 6.1.3）
MODEL_VISION=mimo-v2.6-flash
MODEL_TEXT=mimo-v2.6-flash
MODEL_ASR=mimo-v2.5-asr

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

WORKSPACE_DIR=workspace
REQUEST_TIMEOUT_SEC=180
MAX_RETRIES=2
FRAMES_PER_SHOT=3
# 切点阈值：帧间色差（BT.601 加权归一化），实测硬切 0.40~0.50、同场景明显色变约 0.15
SCENE_THRESHOLD=0.10
