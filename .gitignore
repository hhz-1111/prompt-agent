assets/regression/annotations/thumbs/

# ---- 前端 ----
node_modules/
web/dist/
web/tsconfig.tsbuildinfo

# ---- 大体积素材：只用于本地评测，云端部署不需要 ----
# 24 条测试视频共 177MB，是本地评测的"考卷"；且都是真人素材，
# 不适合推到云端仓库。需要评测时自行放回本目录。
测试素材/
*.mp4
*.MP4
*.mov
*.MOV
*.avi

# ---- 原始 Word 素材 ----
# 正文已经抽取进 assets/corpus/raw/ 与 _extract/，.docx 只是抽取前的原始件，
# 合计约 60MB，部署与运行都不需要。
*.docx
*.doc

# ---- 模型权重与下载残片 ----
# yolov8n.pt 由 ultralytics 首次运行时自动下载；*.part 是下载中断的残片。
yolov8n.pt
*.pt
*.part

# ---- 内部资料：只留在本地，不进仓库 ----
# 本仓库只放"实现功能与能力的代码"。下面是内部文档与评测数据，
# 运行时不需要（唯一例外是 assets/phrases/phrases.json，它必须在仓库里）。
# 这些文件在你本机 D:\deepseek\MOD 仍然存在，只是不再被 Git 跟踪。
PRD-*.md
FRAMEWORK-*.md
AGENT-*.md
MULTIMODAL-*.md
PHRASES-*.md
SAMPLES-*.md
SCORING-*.md
TEMPLATES-*.md
HANDOFF.md
docs/
_extract/

# 内部评测数据：只有 scripts/ 里的评测脚本会读，功能代码不读
assets/corpus/
assets/regression/
assets/eval/
