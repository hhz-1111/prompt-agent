  "grade_patterns": [
    {
      "grade": "F",
      "pattern": "尽量|尽可能|最好|最好是|希望|大概|差不多|争取",
      "label": "愿望式"
    },
    {
      "grade": "E",
      "pattern": "保持一致(?!性参照)|参考图延续|延续参考|自然一些|好看一点|风格统一",
      "label": "泛化表述"
    },
    {
      "grade": "A",
      "pattern": "\\d+(\\.\\d+)?\\s*(%|秒|s|倍|张|个|条)",
      "label": "量化"
    },
    {
      "grade": "D",
      "pattern": "禁止[^。；\\n]{0,60}?(?!\\d)[\\u4e00-\\u9fffA-Za-z]{2,}[、，,][^。；\\n]{0,60}",
      "label": "逐条禁止"
    },
    {
      "grade": "C",
      "pattern": "100%透明|透明字幕|锁定|全程|始终|必须|禁止",
      "label": "目标状态"
    },
